;; This Source Code Form is subject to the terms of the Mozilla Public
;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at https://mozilla.org/MPL/2.0/.
;;
;; conduct.codec: one description of a value that encodes it and decodes
;; it back, in any format. A port of elm-codec
;; (https://github.com/miniBill/elm-codec), Copyright (c) 2019 Leonardo
;; Taglialegne, under the MIT license in LICENSE-elm-codec beside this
;; file, made format-neutral after Rust's serde.
;;
;;   (type x : (geo/x integer))
;;   (type y : (geo/y integer))
;;   (define point (record-codec [x "x" codec/integer] [y "y" codec/integer]))
;;   (encode-text {x: 1, y: 2} with: point)      ; "{\"x\":1,\"y\":2}"
;;   (decode-text "{\"x\":1,\"y\":2}" with: point) ; (ok {x: 1, y: 2})
;;   (encode-cbor {x: 1, y: 2} with: point)      ; [0xa2 0x61 0x78 0x01 0x61 0x79 0x02]
;;   (decode-cbor [0xa2 ..] with: point)         ; (ok {x: 1, y: 2})
;;
;; As serde does, a codec says what a value is in terms of a small data
;; model: null, Booleans, integers, decimals, text, bytes, lists, and
;; named fields. A format reads and writes that model and knows nothing
;; of codecs. JSON and CBOR are here; another format is two functions,
;; `data` to its encoding and back. Serde drives a format from the codec
;; without building the model in between; this builds it, which costs a
;; block a node and needs no traits.
;;
;; A codec is `{codec-to codec-from}`: a function to `data`, and one back
;; that answers `(ok value)` or `(error why)`. Names are elm-codec's,
;; read with their domain: `codec/text`, `codec/list`, `codec/map`.
;;
;; Where this departs from elm-codec:
;; - Records and variants are built by the macros `record-codec` and
;;   `variant-codec` from their attributes and constructors, since conduct
;;   has neither positional constructors nor a pattern-matching function
;;   to pass. `start-record`, `field`, `optional-field` and
;;   `build-record` are what they expand to, for building one by hand.
;; - There is no Maybe: an optional field is an attribute a record may
;;   not have, left out of what is written when absent.
;; - A variant carries one value, so `variant-codec` has no `variant0`
;;   to `variant8`: a variant that carries nothing is a keyword. Variants
;;   are written as elm-codec writes them, fields `tag` and `args`, in
;;   every format, so JSON reads as elm-codec's does.
;; - Decoding fails with a `decode-error` that says where and why, as
;;   Json.Decode's `Error` does, with a keyword for why.
;; - There are no floats, tuples, arrays, sets or dictionaries yet.
;;
;; Requires conduct.parser and conduct.json.

(domain conduct.codec

;; The data model

(type (data-boolean ?b) : {(conduct.codec/data-boolean ?b)})
(type (data-integer ?n) : {(conduct.codec/data-integer ?n)})
(type (data-decimal ?t) : {(conduct.codec/data-decimal ?t)})
(type (data-text ?t) : {(conduct.codec/data-text ?t)})
(type (data-bytes ?b) : {(conduct.codec/data-bytes ?b)})
(type (data-list ?items) : {(conduct.codec/data-list ?items)})
(type (data-fields ?fields) : {(conduct.codec/data-fields ?fields)})
(type field-name : (conduct.codec/field-name text))
(type field-value : (conduct.codec/field-value data))

;; What a codec says a value is, and a format writes. A decimal is the
;; text it was written as, as conduct.json keeps it; fields are in the
;; order the codec gives them, which a format may change.
(type data-field : {field-name field-value})
(type data : [:null (data-boolean boolean) (data-integer integer) (data-decimal text) (data-text text)
              (data-bytes (list byte)) (data-list (list data)) (data-fields (list data-field))])

;; Why a value did not decode

(type failed-name : (conduct.codec/failed-name text))
(type failed-index : (conduct.codec/failed-index natural))
(type failed-cause : (conduct.codec/failed-cause decode-error))
(type failed-reason : (conduct.codec/failed-reason keyword))
(type failed-value : (conduct.codec/failed-value data))
(type failed-offset : (conduct.codec/failed-offset natural))
(type (in-member ?x) : {(conduct.codec/in-member ?x)})
(type (in-item ?x) : {(conduct.codec/in-item ?x)})
(type (none-of ?x) : {(conduct.codec/none-of ?x)})
(type (failure ?x) : {(conduct.codec/failure ?x)})
(type (not-json ?x) : {(conduct.codec/not-json ?x)})
(type (bad-bytes ?x) : {(conduct.codec/bad-bytes ?x)})

;; Where in the value decoding failed, and why: Json.Decode's `Error`;
;; for JSON text, where it stopped being JSON; and for encoded bytes, the
;; offset where reading failed.
(type decode-error : [(in-member {failed-name failed-cause})
                      (in-item {failed-index failed-cause})
                      (none-of (list decode-error))
                      (failure {failed-reason failed-value})
                      (not-json (list (parse-dead-end json-problem)))
                      (bad-bytes {failed-offset failed-reason})])

;; Codecs

(type codec-to : (conduct.codec/to ?to))
(type codec-from : (conduct.codec/from ?from))
(type (codec ?a) : {codec-to: ((\ ?a) : data), codec-from: ((\ data) : (result ?a error: decode-error))})

;; What may be missing: a value that is there, or `:absent`.
(type (present ?v) : {(conduct.codec/present ?v)})

;; A codec from a function to `data` and one back.
(claim (build ((\ ?a) : data) from: ((\ data) : (result ?a error: decode-error))) : (codec ?a))
(define (build to from) {codec-to: to, codec-from: from})

;; A failure to decode `found`, for `reason`.
(claim (fails keyword found: data) : (result nothing error: decode-error))
(define (fails reason found) (error (failure {failed-reason: reason, failed-value: found})))

;; Running

;; `value` as data.
(claim (to-data ?a with: (codec ?a)) : data)
(define (to-data value with) ((codec-to with) value))

;; The value data holds, `(ok value)`, or `(error why)`.
(claim (from-data data with: (codec ?a)) : (result ?a error: decode-error))
(define (from-data d with) ((codec-from with) d))

;; `value` as JSON.
(claim (encode ?a with: (codec ?a)) : json-value)
(define (encode value with) (to-json (to-data value with: with)))

;; The value JSON holds, `(ok value)`, or `(error why)`.
(claim (decode json-value with: (codec ?a)) : (result ?a error: decode-error))
(define (decode j with) (from-data (from-json j) with: with))

;; `value` as JSON text.
(claim (encode-text ?a with: (codec ?a)) : text)
(define (encode-text value with) (to-text (encode value with: with)))

;; The value JSON text holds: `(ok value)`, `(error (not-json dead-ends))`
;; where it is not JSON, or `(error why)` where it does not decode.
(claim (decode-text text with: (codec ?a)) : (result ?a error: decode-error))
(define (decode-text t with)
  (match (from-text t)
    (ok j) (decode j with: with)
    (error ends) (error (not-json ends))))

;; `value` as CBOR.
(claim (encode-cbor ?a with: (codec ?a)) : (list byte))
(define (encode-cbor value with) (to-cbor (to-data value with: with)))

;; The value CBOR holds, all of it: `(ok value)`, or `(error why)`.
(claim (decode-cbor (list byte) with: (codec ?a)) : (result ?a error: decode-error))
(define (decode-cbor bs with)
  (match (from-cbor bs)
    (ok d) (from-data d with: with)
    (error e) (error e)))

;; Primitives

(claim text : (codec text))
(define text
  (build (fn [t] (data-text t))
    from: (fn [d] (match d (data-text t) (ok t) _ (fails :expecting-text found: d)))))

(claim boolean : (codec boolean))
(define boolean
  (build (fn [b] (data-boolean b))
    from: (fn [d] (match d (data-boolean b) (ok b) _ (fails :expecting-boolean found: d)))))

(claim integer : (codec integer))
(define integer
  (build (fn [n] (data-integer n))
    from: (fn [d] (match d (data-integer n) (ok n) _ (fails :expecting-integer found: d)))))

;; An integer that is not negative.
(claim natural : (codec natural))
(define natural
  (build (fn [n] (data-integer n))
    from: (fn [d]
            (match d
              (data-integer n) (if (>= n 0) (ok (conduct/natural n or: 0)) (fails :expecting-natural found: d))
              _ (fails :expecting-natural found: d)))))

;; A natural below 256.
(claim byte : (codec byte))
(define byte
  (build (fn [b] (data-integer b))
    from: (fn [d]
            (match d
              (data-integer n) (let [b (conduct/byte n or: 0)]
                                 (if (= b n) (ok b) (fails :expecting-byte found: d)))
              _ (fails :expecting-byte found: d)))))

;; Bytes: what a format has for them, or, from a format that has none,
;; as JSON has none, a list of naturals below 256.
(claim bytes : (codec (list byte)))
(define bytes
  (build (fn [bs] (data-bytes bs))
    from: (fn [d]
            (match d
              (data-bytes bs) (ok bs)
              (data-list _) ((codec-from (list byte)) d)
              _ (fails :expecting-bytes found: d)))))

;; The data as it is: elm-codec's `value`.
(claim raw : (codec data))
(define raw (build (fn [d] d) from: (fn [d] (ok d))))

;; Each of `cases` encoded with `c`, as `enum-encoded` stands for
;; `enum-decoded`. What no case decodes to encodes as null.
(type enum-encoded : (conduct.codec/enum-encoded ?encoded))
(type enum-decoded : (conduct.codec/enum-decoded ?decoded))
(claim (enum (codec ?a) cases: (list {enum-encoded: ?a, enum-decoded: ?b})) : (codec ?b))
(define (enum c cases)
  (build (fn [v] (enum-encode v cases: cases with: c))
    from: (fn [d]
            (match ((codec-from c) d)
              (error e) (error e)
              (ok k) (enum-decode k cases: cases found: d)))))

(claim (enum-encode ?b cases: (list {enum-encoded: ?a, enum-decoded: ?b}) with: (codec ?a)) : data)
(define (enum-encode v cases with)
  (match cases
    [] :null
    [c rest ...] (if (= (enum-decoded c) v)
                   ((codec-to with) (enum-encoded c))
                   (enum-encode v cases: rest with: with))))

(claim (enum-decode ?a cases: (list {enum-encoded: ?a, enum-decoded: ?b}) found: data) : (result ?b error: decode-error))
(define (enum-decode k cases found)
  (match cases
    [] (fails :unknown-case found: found)
    [c rest ...] (if (= (enum-encoded c) k) (ok (enum-decoded c)) (enum-decode k cases: rest found: found))))

;; Data structures

(claim (list (codec ?a)) : (codec (list ?a)))
(define (list c)
  (build (fn [xs] (data-list (conduct/map xs each: (codec-to c))))
    from: (fn [d]
            (match d
              (data-list items) (decode-items items with: (codec-from c) at: 0 done: [])
              _ (fails :expecting-list found: d)))))

(claim (decode-items (list data) with: ((\ data) : (result ?a error: decode-error)) at: natural done: (list ?a))
  : (result (list ?a) error: decode-error))
(define (decode-items items with at done)
  (match items
    [] (ok done)
    [d rest ...]
    (match (with d)
      (ok x) (decode-items rest with: with at: (+ at 1) done: (conj done x))
      (error e) (error (in-item {failed-index: at, failed-cause: e})))))

;; Mapping

;; `c`, with what it decodes passed through `to`, and what is encoded
;; through `from` first.
(claim (map (codec ?a) to: ((\ ?a) : ?b) from: ((\ ?b) : ?a)) : (codec ?b))
(define (map c to from)
  (build (fn [v] ((codec-to c) (from v)))
    from: (fn [d]
            (match ((codec-from c) d)
              (ok x) (ok (to x))
              (error e) (error e)))))

;; A codec chosen by what `c` decoded: decode with `c`, then with the
;; codec `to` makes of it; encode `from` of a value with `c`.
(claim (and-then (codec ?a) to: ((\ ?a) : (codec ?b)) from: ((\ ?b) : ?a)) : (codec ?b))
(define (and-then c to from)
  (build (fn [v] ((codec-to c) (from v)))
    from: (fn [d]
            (match ((codec-from c) d)
              (ok x) ((codec-from (to x)) d)
              (error e) (error e)))))

;; Encode with `c`; decode with `c`, or else with each of `fallbacks` in
;; turn, which is how a codec reads what older versions of it wrote.
(claim (one-of (codec ?a) fallbacks: (list (codec ?a))) : (codec ?a))
(define (one-of c fallbacks)
  (build (codec-to c) from: (fn [d] (decode-first (concat [c] fallbacks) data: d errors: []))))

(claim (decode-first (list (codec ?a)) data: data errors: (list decode-error)) : (result ?a error: decode-error))
(define (decode-first cs data errors)
  (match cs
    [] (error (none-of errors))
    [c rest ...]
    (match ((codec-from c) data)
      (ok x) (ok x)
      (error e) (decode-first rest data: data errors: (conj errors e)))))

;; Fancy

;; Decodes as `value` whatever the data; encodes as null.
(claim (succeed ?a) : (codec ?a))
(define (succeed value) (build (fn [_] :null) from: (fn [_] (ok value))))

;; Fails to decode, for `reason`; encodes as null.
(claim (fail keyword) : (codec nothing))
(define (fail reason) (build (fn [_] :null) from: (fn [d] (fails reason found: d))))

;; The codec `make` answers, made when it is used: a codec that refers
;; to itself is written with it, or with `recursive`.
(claim (lazy ((\ any) : (codec ?a))) : (codec ?a))
(define (lazy make)
  (build (fn [v] ((codec-to (make {})) v)) from: (fn [d] ((codec-from (make {})) d))))

;; The codec `f` makes of itself: `(recursive (fn [tree] ..))`.
(claim (recursive ((\ (codec ?a)) : (codec ?a))) : (codec ?a))
(define (recursive f) (f (lazy (fn [_] (recursive f)))))

;; Records

(type builder-to : (conduct.codec/builder-to ?to))
(type builder-from : (conduct.codec/builder-from ?from))

;; A record codec being built: it encodes a `?w` as fields, and decodes
;; fields into a `?p`, which grows by a field at each step until it is
;; the record.
(type (record-builder ?w building: ?p) : {builder-to: ((\ ?w) : (list data-field)),
                                          builder-from: ((\ (list data-field)) : (result ?p error: decode-error))})

;; A record codec that starts from `empty` and has no fields yet.
(claim (start-record ?p) : (record-builder any building: ?p))
(define (start-record empty) {builder-to: (fn [_] []), builder-from: (fn [_] (ok empty))})

(claim (missing text fields: (list data-field)) : (result nothing error: decode-error))
(define (missing name fields)
  (error (in-member {failed-name: name,
                     failed-cause: (failure {failed-reason: :missing-member, failed-value: (data-fields fields)})})))

;; `b` with a field `name`, read from a record with `get`, encoded with
;; `codec`, and added to the record being decoded with `set`.
(claim (field (record-builder ?w building: ?p) name: text get: ((\ ?w) : ?f) set: ((\ ?p) : ((\ ?f) : ?q)) codec: (codec ?f))
  : (record-builder ?w building: ?q))
(define (field b name get set codec: c)
  {builder-to: (fn [w] (conj ((builder-to b) w) {field-name: name, field-value: ((codec-to c) (get w))})),
   builder-from:
   (fn [fields]
     (match ((builder-from b) fields)
       (error e) (error e)
       (ok p)
       (match (find-field fields name: name)
         :absent (missing name fields: fields)
         (present d)
         (match ((codec-from c) d)
           (ok f) (ok ((set p) f))
           (error e) (error (in-member {failed-name: name, failed-cause: e}))))))})

;; `field`, for a field that may be missing: `get` answers `(present
;; value)` or `:absent`, and an absent value is left out of what is
;; written and out of the decoded record.
(claim (optional-field (record-builder ?w building: ?p) name: text get: ((\ ?w) : [(present ?f) :absent])
                       set: ((\ ?p) : ((\ ?f) : ?q)) codec: (codec ?f))
  : (record-builder ?w building: [?p ?q]))
(define (optional-field b name get set codec: c)
  {builder-to:
   (fn [w]
     (match (get w)
       (present f) (conj ((builder-to b) w) {field-name: name, field-value: ((codec-to c) f)})
       :absent ((builder-to b) w))),
   builder-from:
   (fn [fields]
     (match ((builder-from b) fields)
       (error e) (error e)
       (ok p)
       (match (find-field fields name: name)
         :absent (ok p)
         (present d)
         (match ((codec-from c) d)
           (ok f) (ok ((set p) f))
           (error e) (error (in-member {failed-name: name, failed-cause: e}))))))})

;; `b` with a field `name` that is always `value`: encoded, and checked
;; when decoding, as a `"type"` field is.
(claim (constant-field (record-builder ?w building: ?p) name: text value: ?f codec: (codec ?f)) : (record-builder ?w building: ?p))
(define (constant-field b name value codec: c)
  {builder-to: (fn [w] (conj ((builder-to b) w) {field-name: name, field-value: ((codec-to c) value)})),
   builder-from:
   (fn [fields]
     (match ((builder-from b) fields)
       (error e) (error e)
       (ok p)
       (match (find-field fields name: name)
         :absent (missing name fields: fields)
         (present d)
         (match ((codec-from c) d)
           (ok f) (if (= f value)
                    (ok p)
                    (error (in-member {failed-name: name, failed-cause: (failure {failed-reason: :unexpected-value, failed-value: d})})))
           (error e) (error (in-member {failed-name: name, failed-cause: e}))))))})

;; The codec `b` has built, of fields.
(claim (build-record (record-builder ?a building: ?a)) : (codec ?a))
(define (build-record b)
  (build (fn [v] (data-fields ((builder-to b) v)))
    from: (fn [d]
            (match d
              (data-fields fields) ((builder-from b) fields)
              _ (fails :expecting-fields found: d)))))

(claim (find-field (list data-field) name: text) : [(present data) :absent])
(define (find-field fields name)
  (match fields
    [] :absent
    [f rest ...] (if (= (field-name f) name) (present (field-value f)) (find-field rest name: name))))

;; `(record-codec [attribute "name" codec] ..)`: a codec of records of
;; the attributes named, each as the field `name`. A row ending in
;; `:optional` is an attribute the record may lack.
(macro (record-codec row ...) (./build-record (record-fields (./start-record {}) row ...)))

(macro (record-fields b) b)
(macro (record-fields b [attr key c] rest ...)
  (record-fields (./field b name: key get: (fn [r] (attr r)) set: (fn [r] (fn [v] (assoc r attr: v))) codec: c)
                 rest ...))
(macro (record-fields b [attr key c :optional] rest ...)
  (record-fields (./optional-field b name: key get: (fn [r] (match r {attr: v} (present v) _ :absent))
                                   set: (fn [r] (fn [v] (assoc r attr: v))) codec: c)
                 rest ...))

;; Variants

(type variant-tag : (conduct.codec/variant-tag text))
(type variant-from : (conduct.codec/variant-from ?from))
(type (variant-case ?a) : {variant-tag: text, variant-from: ((\ (list data)) : (result ?a error: decode-error))})

;; A variant as elm-codec writes it: fields `tag` and `args`.
(claim (tagged text args: (list data)) : data)
(define (tagged tag args)
  (data-fields [{field-name: "tag", field-value: (data-text tag)} {field-name: "args", field-value: (data-list args)}]))

;; The value of the case `d`'s tag names.
(claim (decode-variant data cases: (list (variant-case ?a))) : (result ?a error: decode-error))
(define (decode-variant d cases)
  (match d
    (data-fields fields)
    (match (find-field fields name: "tag")
      (present (data-text tag))
      (match (find-field fields name: "args")
        (present (data-list args)) (decode-case tag args: args cases: cases found: d)
        _ (error (in-member {failed-name: "args", failed-cause: (failure {failed-reason: :expecting-list, failed-value: d})})))
      _ (error (in-member {failed-name: "tag", failed-cause: (failure {failed-reason: :expecting-text, failed-value: d})})))
    _ (fails :expecting-fields found: d)))

(claim (decode-case text args: (list data) cases: (list (variant-case ?a)) found: data) : (result ?a error: decode-error))
(define (decode-case tag args cases found)
  (match cases
    [] (fails :unknown-tag found: found)
    [c rest ...] (if (= (variant-tag c) tag)
                   ((variant-from c) args)
                   (decode-case tag args: args cases: rest found: found))))

;; The first of a variant's arguments, decoded with `with`.
(claim (first-arg (list data) with: (codec ?a)) : (result ?a error: decode-error))
(define (first-arg args with)
  (match args
    [d _ ...]
    (match ((codec-from with) d)
      (ok x) (ok x)
      (error e) (error (in-member {failed-name: "args", failed-cause: (in-item {failed-index: 0, failed-cause: e})})))
    [] (error (in-member {failed-name: "args", failed-cause: (failure {failed-reason: :expecting-argument,
                                                                         failed-value: (data-list args)})}))))

;; `(variant-codec [constructor "tag" codec] [:keyword "tag"] ..)`: a
;; codec of the variants named, each carrying a value encoded with its
;; codec, or, for a keyword, nothing. A value of none of them encodes as
;; null.
(macro (variant-codec row ...)
  (./build (fn [v] (variant-encode v row ...))
    from: (fn [d] (./decode-variant d cases: [(variant-case-of row) ...]))))

(macro (variant-encode v) :null)
(macro (variant-encode v [ctor tag c] rest ...)
  (match v (ctor x) (./tagged tag args: [((codec-to c) x)]) _ (variant-encode v rest ...)))
(macro (variant-encode v [kw tag] rest ...)
  (match v kw (./tagged tag args: []) _ (variant-encode v rest ...)))

(macro (variant-case-of [ctor tag c])
  {variant-tag: tag, variant-from: (fn [args] (match (./first-arg args with: c) (ok x) (ok (ctor x)) (error e) (error e)))})
(macro (variant-case-of [kw tag]) {variant-tag: tag, variant-from: (fn [_] (ok kw))})

;; JSON

;; Data as JSON: bytes, which JSON has none of, as a list of naturals.
(claim (to-json data) : json-value)
(define (to-json d)
  (match d
    :null :null
    (data-boolean b) (bool b)
    (data-integer n) (number n)
    (data-decimal t) (decimal t)
    (data-text t) (string t)
    (data-bytes bs) (array (conduct/map bs each: (fn [b] (number b))))
    (data-list items) (array (conduct/map items each: to-json))
    (data-fields fields)
    (object (conduct/map fields each: (fn [f] {member-name: (field-name f), member-value: (to-json (field-value f))})))))

;; JSON as data.
(claim (from-json json-value) : data)
(define (from-json j)
  (match j
    :null :null
    (bool b) (data-boolean b)
    (number n) (data-integer n)
    (decimal t) (data-decimal t)
    (string t) (data-text t)
    (array items) (data-list (conduct/map items each: from-json))
    (object members)
    (data-fields (conduct/map members each: (fn [m] {field-name: (member-name m), field-value: (from-json (member-value m))})))))

;; CBOR (RFC 8949)
;;
;; Written deterministically, by the core rules of RFC 8949 4.2.1: every
;; integer and length in its shortest form, definite lengths, and a map's
;; keys in the bytewise order of their encodings, which for text keys is
;; by length and then bytewise, as DAG-CBOR orders them. So equal data is
;; equal bytes, and its hash is its identity. Reading accepts any order
;; and any form of integer, but not indefinite lengths, floats, or tags
;; other than 4, a decimal fraction. A map's keys must be text.

(claim (to-cbor data) : (list byte))
(define (to-cbor d) (write-cbor d into: []))

;; The data CBOR holds, all of it: `(ok data)`, or `(error why)`.
(claim (from-cbor (list byte)) : (result data error: decode-error))
(define (from-cbor bs)
  (match (read-cbor bs at: 0)
    (error e) (error e)
    (ok {read-value: d, read-next: n}) (if (= n (count bs)) (ok d) (fails-at :trailing-bytes at: n))))

;; The low eight bits of `n`.
(claim (low-byte natural) : byte)
(define (low-byte n) (conduct/byte (bit-and n 255) or: 0))

;; `bs` after `into`, a byte at a time, so `into` grows in place.
(claim (append (list byte) into: (list byte) at: natural) : (list byte))
(define (append bs into at)
  (if (>= at (count bs)) into (append bs into: (conj into (item bs at: at or: 0)) at: (+ at 1))))

;; The initial byte and argument of an item of major type `major`.
(claim (write-head natural argument: natural into: (list byte)) : (list byte))
(define (write-head major argument into)
  (let [m (* major 32)]
    (cond
      (< argument 24) (conj into (low-byte (+ m argument)))
      (< argument 256) (write-be argument size: 1 into: (conj into (low-byte (+ m 24))))
      (< argument 65536) (write-be argument size: 2 into: (conj into (low-byte (+ m 25))))
      (< argument 4294967296) (write-be argument size: 4 into: (conj into (low-byte (+ m 26))))
      :else (write-be argument size: 8 into: (conj into (low-byte (+ m 27)))))))

;; The low `size` bytes of `n`, most significant first.
(claim (write-be natural size: natural into: (list byte)) : (list byte))
(define (write-be n size into)
  (if (= size 0)
    into
    (let [left (conduct/natural (- size 1) or: 0)]
      (write-be n size: left into: (conj into (low-byte (shift-right n (* 8 left))))))))

(claim (write-integer integer into: (list byte)) : (list byte))
(define (write-integer n into)
  (if (>= n 0)
    (write-head 0 argument: (conduct/natural n or: 0) into: into)
    (write-head 1 argument: (conduct/natural (- -1 n) or: 0) into: into)))

(claim (write-text text into: (list byte)) : (list byte))
(define (write-text t into) (append (utf8 t) into: (write-head 3 argument: (byte-count t) into: into) at: 0))

(claim (write-cbor data into: (list byte)) : (list byte))
(define (write-cbor d into)
  (match d
    :null (conj into 0xf6)
    (data-boolean b) (conj into (if b 0xf5 0xf4))
    (data-integer n) (write-integer n into: into)
    (data-decimal t) (write-decimal t into: into)
    (data-text t) (write-text t into: into)
    (data-bytes bs) (append bs into: (write-head 2 argument: (count bs) into: into) at: 0)
    (data-list items) (write-all items into: (write-head 4 argument: (count items) into: into))
    (data-fields fields)
    (write-entries (sort-entries (conduct/map fields each: (fn [f] {entry-key: (write-text (field-name f) into: []),
                                                                     entry-value: (field-value f)}))
                                 sorted: [])
                   into: (write-head 5 argument: (count fields) into: into))))

(claim (write-all (list data) into: (list byte)) : (list byte))
(define (write-all items into)
  (match items
    [] into
    [d rest ...] (write-all rest into: (write-cbor d into: into))))

;; A map's entry: its key, encoded, and its value.
(type entry-key : (conduct.codec/entry-key (list byte)))
(type entry-value : (conduct.codec/entry-value data))

;; `entries` in the bytewise order of their keys, by insertion: a record
;; has few fields.
(claim (sort-entries (list {entry-key entry-value}) sorted: (list {entry-key entry-value})) : (list {entry-key entry-value}))
(define (sort-entries entries sorted)
  (match entries
    [] sorted
    [e rest ...] (sort-entries rest sorted: (insert-entry e into: sorted))))

(claim (insert-entry {entry-key entry-value} into: (list {entry-key entry-value})) : (list {entry-key entry-value}))
(define (insert-entry e into)
  (match into
    [] [e]
    [s rest ...] (if (< (compare (entry-key e) (entry-key s)) 0)
                   (concat [e] into)
                   (concat [s] (insert-entry e into: rest)))))

(claim (write-entries (list {entry-key entry-value}) into: (list byte)) : (list byte))
(define (write-entries entries into)
  (match entries
    [] into
    [e rest ...] (write-entries rest into: (write-cbor (entry-value e) into: (append (entry-key e) into: into at: 0)))))

;; A decimal as RFC 8949's decimal fraction, tag 4 of `[exponent
;; mantissa]`, read from the text JSON wrote it as. A mantissa past 18
;; digits does not fit an integer yet, and is written as its text.
(claim (write-decimal text into: (list byte)) : (list byte))
(define (write-decimal t into)
  (match (decimal-parts (utf8 t) at: 0 mantissa: 0 digits: 0 point: -1 sign: 1)
    (present {decimal-mantissa: m, decimal-exponent: e})
    (write-integer m into: (write-integer e into: (conj (conj into 0xc4) 0x82)))
    :absent (write-text t into: into)))

(type decimal-mantissa : (conduct.codec/decimal-mantissa integer))
(type decimal-exponent : (conduct.codec/decimal-exponent integer))

;; JSON's number grammar read into a mantissa and an exponent: digits
;; before and after a point, then `e` and an exponent. `point` is the
;; number of digits after the point so far, or -1 before it.
(claim (decimal-parts (list byte) at: natural mantissa: natural digits: natural point: integer sign: integer)
  : [(present {decimal-mantissa decimal-exponent}) :absent])
(define (decimal-parts bs at mantissa digits point sign)
  (let [c (item bs at: at or: 0)
        after (if (< point 0) 0 point)]
    (cond
      (> digits 18) :absent
      (>= at (count bs)) (present {decimal-mantissa: (* sign mantissa), decimal-exponent: (- 0 after)})
      (= c 45) (decimal-parts bs at: (+ at 1) mantissa: mantissa digits: digits point: point sign: -1)
      (= c 46) (decimal-parts bs at: (+ at 1) mantissa: mantissa digits: digits point: 0 sign: sign)
      (or (= c 101) (= c 69))
      (match (exponent-of bs at: (+ at 1) value: 0 sign: 1)
        (present e) (present {decimal-mantissa: (* sign mantissa), decimal-exponent: (- e after)})
        :absent :absent)
      (and (>= c 48) (<= c 57))
      (decimal-parts bs at: (+ at 1) mantissa: (+ (* mantissa 10) (- c 48))
                     digits: (if (and (= mantissa 0) (= c 48)) digits (+ digits 1))
                     point: (if (< point 0) point (+ point 1)) sign: sign)
      :else :absent)))

(claim (exponent-of (list byte) at: natural value: natural sign: integer) : [(present integer) :absent])
(define (exponent-of bs at value sign)
  (let [c (item bs at: at or: 0)]
    (cond
      (> value 100000000) :absent
      (>= at (count bs)) (present (* sign value))
      (= c 45) (exponent-of bs at: (+ at 1) value: value sign: -1)
      (= c 43) (exponent-of bs at: (+ at 1) value: value sign: 1)
      (and (>= c 48) (<= c 57)) (exponent-of bs at: (+ at 1) value: (+ (* value 10) (- c 48)) sign: sign)
      :else :absent)))

;; Reading CBOR

(type read-value : (conduct.codec/read-value ?value))
(type read-next : (conduct.codec/read-next natural))

;; What reading found, and the offset just after it.
(type (read-step ?a) : {read-value: ?a, read-next: natural})

;; A failure to read bytes at `at`, for `reason`.
(claim (fails-at keyword at: natural) : (result nothing error: decode-error))
(define (fails-at reason at) (error (bad-bytes {failed-offset: at, failed-reason: reason})))

(claim (read-ok ?a next: natural) : (result (read-step ?a) error: nothing))
(define (read-ok value next) (ok {read-value: value, read-next: next}))

;; The data item at `at`.
(claim (read-cbor (list byte) at: natural) : (result (read-step data) error: decode-error))
(define (read-cbor bs at)
  (if (>= at (count bs))
    (fails-at :unexpected-end at: at)
    (let [initial (item bs at: at or: 0)
          major (shift-right initial 5)
          info (bit-and initial 31)]
      (if (= major 7)
        (cond
          (= info 20) (read-ok (data-boolean false) next: (+ at 1))
          (= info 21) (read-ok (data-boolean true) next: (+ at 1))
          (= info 22) (read-ok :null next: (+ at 1))
          (and (>= info 25) (<= info 27)) (fails-at :unsupported-float at: at)
          :else (fails-at :unsupported-simple-value at: at))
        (match (read-argument bs at: (+ at 1) info: info start: at)
          (error e) (error e)
          (ok {read-value: n, read-next: k})
          (cond
            (= major 0) (read-ok (data-integer n) next: k)
            (= major 1) (read-ok (data-integer (- -1 n)) next: k)
            (= major 2) (read-span bs at: k count: n)
            (= major 3) (read-text bs at: k count: n)
            (= major 4) (read-items bs at: k left: n index: 0 done: [])
            (= major 5) (read-entries bs at: k left: n done: [])
            (= n 4) (read-decimal bs at: k start: at)
            :else (fails-at :unsupported-tag at: at)))))))

;; The argument an initial byte's low five bits give: themselves below
;; 24, else the next 1, 2, 4 or 8 bytes. An integer holds 62 bits, so
;; an argument of 2^61 or more is too large.
(claim (read-argument (list byte) at: natural info: natural start: natural) : (result (read-step natural) error: decode-error))
(define (read-argument bs at info start)
  (cond
    (< info 24) (read-ok info next: at)
    (= info 24) (read-be bs at: at size: 1 total: 0 start: start)
    (= info 25) (read-be bs at: at size: 2 total: 0 start: start)
    (= info 26) (read-be bs at: at size: 4 total: 0 start: start)
    (= info 27) (if (>= (item bs at: at or: 0) 32)
                  (fails-at :integer-too-large at: start)
                  (read-be bs at: at size: 8 total: 0 start: start))
    (= info 31) (fails-at :indefinite-length at: start)
    :else (fails-at :reserved-argument at: start)))

(claim (read-be (list byte) at: natural size: natural total: natural start: natural) : (result (read-step natural) error: decode-error))
(define (read-be bs at size total start)
  (cond
    (= size 0) (read-ok total next: at)
    (>= at (count bs)) (fails-at :unexpected-end at: at)
    :else (read-be bs at: (+ at 1) size: (conduct/natural (- size 1) or: 0)
                   total: (+ (shift-left total 8) (item bs at: at or: 0)) start: start)))

;; The `n` bytes at `at`.
(claim (read-span (list byte) at: natural count: natural) : (result (read-step data) error: decode-error))
(define (read-span bs at count: n)
  (if (> (+ at n) (count bs))
    (fails-at :unexpected-end at: (count bs))
    (read-ok (data-bytes (slice bs from: at to: (+ at n))) next: (+ at n))))

;; The text of the `n` bytes at `at`. Nothing that is not UTF-8 reads as
;; "", so "" is the answer only for no bytes.
(claim (read-text (list byte) at: natural count: natural) : (result (read-step data) error: decode-error))
(define (read-text bs at count: n)
  (if (> (+ at n) (count bs))
    (fails-at :unexpected-end at: (count bs))
    (let [t (from-utf8 (slice bs from: at to: (+ at n)) or: "")]
      (if (and (= t "") (> n 0)) (fails-at :invalid-utf8 at: at) (read-ok (data-text t) next: (+ at n))))))

(claim (read-items (list byte) at: natural left: natural index: natural done: (list data))
  : (result (read-step data) error: decode-error))
(define (read-items bs at left index done)
  (if (= left 0)
    (read-ok (data-list done) next: at)
    (match (read-cbor bs at: at)
      (ok {read-value: d, read-next: k})
      (read-items bs at: k left: (conduct/natural (- left 1) or: 0) index: (+ index 1) done: (conj done d))
      (error e) (error (in-item {failed-index: index, failed-cause: e})))))

(claim (read-entries (list byte) at: natural left: natural done: (list data-field))
  : (result (read-step data) error: decode-error))
(define (read-entries bs at left done)
  (if (= left 0)
    (read-ok (data-fields done) next: at)
    (match (read-cbor bs at: at)
      (error e) (error e)
      (ok {read-value: (data-text name), read-next: k})
      (match (read-cbor bs at: k)
        (ok {read-value: d, read-next: next})
        (read-entries bs at: next left: (conduct/natural (- left 1) or: 0) done: (conj done {field-name: name, field-value: d}))
        (error e) (error (in-member {failed-name: name, failed-cause: e})))
      (ok _) (fails-at :expecting-text-key at: at))))

;; Tag 4, `[exponent mantissa]`, as the decimal `<mantissa>e<exponent>`.
(claim (read-decimal (list byte) at: natural start: natural) : (result (read-step data) error: decode-error))
(define (read-decimal bs at start)
  (match (read-cbor bs at: at)
    (ok {read-value: (data-list [(data-integer e) (data-integer m)]), read-next: next})
    (read-ok (data-decimal (str m "e" e)) next: next)
    (ok _) (fails-at :expecting-decimal-fraction at: start)
    (error e) (error e)))

;; Errors

;; `e` as a sentence, as Json.Decode's `errorToString` writes one.
(claim (error-text decode-error) : text)
(define (error-text e) (error-text-at e path: "value"))

(claim (error-text-at decode-error path: text) : text)
(define (error-text-at e path)
  (match e
    (in-member {failed-name: n, failed-cause: inner}) (error-text-at inner path: (str path "." n))
    (in-item {failed-index: i, failed-cause: inner}) (error-text-at inner path: (str path "[" i "]"))
    (none-of errors) (str "none of " (count errors) " ways to decode the value at `" path "` fits: "
                          (join (conduct/map errors each: error-text) with: "; "))
    (failure {failed-reason: why, failed-value: d})
    (str "the value at `" path "` fails with " why ": " (to-text (to-json d)))
    (not-json ends) (match ends
                      [] "the text is not JSON"
                      [end _ ...] (str "the text is not JSON at " (row end) ":" (col end) ": " (reason end)))
    (bad-bytes {failed-offset: at, failed-reason: why})
    (str "the bytes of `" path "` fail at offset " at " with " why))))
