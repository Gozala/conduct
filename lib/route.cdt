;;
;; conduct.route: routes that parse a path into typed parameters and
;; format parameters back into a path, from one description. After
;; subroute (https://github.com/Gozala/subroute), which builds both from a
;; tagged template; here a macro builds both at compile time, so a link
;; cannot drift from the route it points at, and a parameter's type is
;; its attribute's.
;;
;;   (type a : (calc/a natural))
;;   (type b : (calc/b natural))
;;   (define calc (route "/calculator/" (a natural-segment) "/+/" (b natural-segment)))
;;   (match-path calc path: "/calculator/313/+/3")   ; (ok {a: 313, b: 3})
;;   (format-path calc params: {a: 313, b: 3})      ; "/calculator/313/+/3"
;;
;; A route is `{route-parse route-format}`: a conduct.parser parser of the
;; whole path, and a function from the parameters to the path. A segment
;; is the same pair for one parameter. The route's parameters are a
;; record of the attributes its captures name.
;;
;; Requires conduct.parser.

(domain conduct.route

(type route-parse : (conduct.route/parse ?parser))
(type route-format : (conduct.route/format ?formatter))
(type segment-parse : (conduct.route/segment-parse ?parser))
(type segment-format : (conduct.route/segment-format ?formatter))

;; `(route piece ..)`: each piece is literal text, matched exactly, or
;; `(name segment)`, which captures the attribute `name` with `segment`.
;; The macro walks the pieces once, building the parser's bindings, the
;; formatter's pieces and the parameters' names side by side; `v` is the
;; parameters in the formatter, named once so every piece reads the same.
(macro (route piece ...) (route-from v [] [] [] piece ...))

(macro (route-from v [bind ...] [out ...] [field ...] (name segment) rest ...)
  (route-from v [bind ... name (segment-parse segment)]
                [out ... ((segment-format segment) (name v))]
                [field ... name]
                rest ...))

(macro (route-from v [bind ...] [out ...] [field ...] literal rest ...)
  (route-from v [bind ... _ (symbol literal)] [out ... literal] [field ...] rest ...))

(macro (route-from v [bind ...] [out ...] [field ...])
  {route-parse: (parsing [bind ... _ (end :expecting-end)] (succeed {field: field ...})),
   route-format: (fn [v] (str out ...))})

;; The parameters of `path`, `(ok params)`, or `(error dead-ends)`.
(define (match-path r path) (run (route-parse r) text: path))

;; The path of `params`.
(define (format-path r params) ((route-format r) params))

;; Segments

;; A natural in decimal.
(define natural-segment
  {segment-parse: (int :expecting-natural invalid: :invalid-natural),
   segment-format: (fn [n] (str n))})

;; Text up to the next `/`, `?` or `#`, at least one byte of it, with
;; each `%XX` read as the byte it stands for and the bytes as UTF-8; and
;; formatted with every byte a path segment may not hold as `%XX`, so
;; the text survives a `/` or a space in it.
(define text-segment
  {segment-parse:
   (and-then (get-chomped (skip (chomp-if segment-char? expecting: :expecting-text) then: (chomp-while segment-char?)))
     with: (fn [raw]
             (match (percent-decode raw)
               (percent-decoded t) (succeed t)
               :absent (fail :invalid-percent-encoding)))),
   segment-format: (fn [t] (percent-encode t))})

(define (segment-char? c) (not (or (= c 47) (= c 63) (= c 35))))

;; Percent-encoding (RFC 3986)

(type (percent-decoded ?t) : {(conduct.route/percent-decoded ?t)})

;; The text `raw` stands for, each `%XX` the byte XX in hexadecimal:
;; `(percent-decoded text)`, or `:absent` where a `%` has no two hex
;; digits after it or the bytes are not UTF-8.
(claim (percent-decode text) : [(percent-decoded text) :absent])
(define (percent-decode raw) (decode-from (utf8 raw) at: 0 out: []))

(claim (decode-from (list byte) at: natural out: (list byte)) : [(percent-decoded text) :absent])
(define (decode-from bs at out)
  (if (>= at (count bs))
    ;; Nothing that is not UTF-8 reads as "", so "" means no bytes.
    (let [t (from-utf8 out or: "")] (if (and (= t "") (> (count out) 0)) :absent (percent-decoded t)))
    (let [b (item bs at: at or: 0)]
      (if (= b 37)
        (let [high (hex-digit (item bs at: (+ at 1) or: 0))
              low (hex-digit (item bs at: (+ at 2) or: 0))]
          (if (or (= high 16) (= low 16))
            :absent
            (decode-from bs at: (+ at 3) out: (conj out (byte (+ (* high 16) low) or: 0)))))
        (decode-from bs at: (+ at 1) out: (conj out b))))))

;; The value of a hexadecimal digit's byte, or 16 for any other byte.
(claim (hex-digit byte) : natural)
(define (hex-digit c)
  (cond
    (and (>= c 48) (<= c 57)) (natural (- c 48) or: 16)
    (and (>= c 65) (<= c 70)) (natural (- c 55) or: 16)
    (and (>= c 97) (<= c 102)) (natural (- c 87) or: 16)
    :else 16))

;; `t` as a path segment: every byte but a path character's as `%XX`.
(claim (percent-encode text) : text)
(define (percent-encode t) (join (map (utf8 t) each: escape-byte) with: ""))

(claim (escape-byte byte) : text)
(define (escape-byte b)
  (if (path-char? b)
    (from-code-point b)
    (str "%" (slice "0123456789ABCDEF" from: (shift-right b 4) to: (+ (shift-right b 4) 1))
             (slice "0123456789ABCDEF" from: (bit-and b 15) to: (+ (bit-and b 15) 1)))))

;; RFC 3986's `pchar` but `%`: unreserved characters, sub-delimiters,
;; `:` and `@`.
(claim (path-char? byte) : boolean)
(define (path-char? b)
  (or (and (>= b 97) (<= b 122))
      (and (>= b 65) (<= b 90))
      (and (>= b 48) (<= b 57))
      (= b 45) (= b 46) (= b 95) (= b 126)
      (= b 33) (= b 36) (= b 38) (= b 39) (= b 40) (= b 41) (= b 42) (= b 43) (= b 44) (= b 59) (= b 61)
      (= b 58) (= b 64)))

;; Routers

;; `r`, answering what `handler` makes of its parameters.
(define (on r handler) (map-value (route-parse r) with: handler))

;; The first of `routes`, each made with `on`, that matches `path`:
;; `(ok answer)`, or `(error dead-ends)` with every route's.
(define (dispatch routes path) (run (one-of routes) text: path)))
