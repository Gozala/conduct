;; The route /api/todos: the whole todo list.
;;
;; GET answers the todos that `?filter=` selects (all, active, or
;; completed) and the counts of the whole list. POST adds a todo from
;; {"title": string}. PATCH sets every todo's completion from
;; {"completed": bool}. DELETE removes every completed todo.
;;
;; `handle` is defined marked `!`: it makes a task, which the platform
;; performs. Its task calls the model, and the route contract lets it
;; need the `model` capability and no other.

(define pattern "/api/todos")

(define (todo-json todo)
  {:id (id todo) :title (title todo) :completed (completed todo)})

(define (filter-of request)
  (match (get :filter of: (search request) or: "all")
    "active" :active
    "completed" :completed
    _ :all))

(define (list! request)
  (let [found (query! (filter-of request))
        counts (counts found)]
    (json {:todos (map (todos found) each: todo-json)
           :counts {:active (active-count counts) :completed (completed-count counts)}}
          status: 200)))

(define (add-todo! request)
  (match (add! (json-str (json-get (parse-json (body request)) "title")))
    (ok todo) (json (todo-json todo) status: 201)
    (error why) (problem why)))

(define (complete-all! request)
  (let [completed (json-get (parse-json (body request)) "completed")]
    (cond
      (= completed true) (do (toggle-all! true) (status 204))
      (= completed false) (do (toggle-all! false) (status 204))
      :else (status 400))))

(claim (handle! request) with: {model} : response)
(define (handle! request)
  (match (method request)
    "GET" (list! request)
    "POST" (add-todo! request)
    "PATCH" (complete-all! request)
    "DELETE" (do (clear-completed!) (status 204))
    _ (status 405)))
