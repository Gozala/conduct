; <todo-item>: one todo. It shows the checkbox, the title, and the
; delete button, and edits the title in place after a double-click:
; Enter or leaving the field saves the edit, and Escape cancels it. It
; reports each change as a custom event that <todo-app> handles.
;
; The same element as the Zena demo's todo-item.zena, as pure
; definitions: `update` returns the events to send instead of sending
; them.

(define attributes ["todo-id" "title" "completed"])

(define styles "
  :host {
    display: block;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 8px 0 16px;
    border-radius: var(--md-sys-shape-corner-medium);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
  li:hover {
    background: var(--md-sys-color-surface-container);
  }
  .toggle {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--md-sys-color-primary);
  }
  label {
    flex: 1;
    padding: 16px 0;
    word-break: break-word;
  }
  li.completed label {
    color: var(--md-sys-color-outline);
    text-decoration: line-through;
  }
  .destroy {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 22px;
    cursor: pointer;
    opacity: 0;
  }
  li:hover .destroy, .destroy:focus {
    opacity: 1;
  }
  .destroy:hover {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }
  .edit {
    flex: 1;
    margin: 6px 0;
    padding: 12px 16px;
    border: none;
    border-radius: var(--md-sys-shape-corner-small);
    outline: 2px solid var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
")

(type editing : (demo.todo-item/editing boolean))

(define (init attrs) {editing: false})

(define (stay model) {model: model, effects: []})

(define (id-of attrs) (get :todo-id of: attrs or: ""))

(define (save title attrs)
  {model: {editing: false}
   effects: [(emit "todo-edit" (str (id-of attrs) "\n" title))]})

;; `update` is defined by clauses: a call takes the narrowest one that
;; matches it, so the last, which matches anything, is what any other
;; event does.
(define (update model handler: "toggle" event attrs)
  {model: model, effects: [(emit "todo-toggle" (id-of attrs))]})
(define (update model handler: "destroy" event attrs)
  {model: model, effects: [(emit "todo-destroy" (id-of attrs))]})
(define (update model handler: "edit" event attrs) (stay {editing: true}))
(define (update model handler: "key" event: {key: "Escape"} attrs) (stay {editing: false}))
(define (update {editing: true} handler: "key" event: {key: "Enter" value: title} attrs) (save title attrs: attrs))
(define (update {editing: true} handler: "save" event attrs) (save (value event "") attrs: attrs))
(define (update model handler event attrs) (stay model))

(define (view model attrs)
  (let [done (= (get :completed of: attrs or: "") "true")
        title (get :title of: attrs or: "")]
    (if (editing model)
      (h "li" {:class "editing"}
        [(h "input" {:key "edit"
                     :class "edit"
                     :value title
                     :autofocus ""
                     :aria-label "Edit the todo"}
            []
            {:keydown "key" :blur "save"})])
      (h "li" {:class (if done "completed" "")}
        [(h "input" {:key "toggle"
                     :class "toggle"
                     :type "checkbox"
                     :checked (if done "true" "false")
                     :aria-label "Toggle the todo"}
            []
            {:change "toggle"})
         (h "label" {} [title] {:dblclick "edit"})
         (h "button" {:class "destroy" :aria-label "Delete the todo"} ["×"] {:click "destroy"})]))))
