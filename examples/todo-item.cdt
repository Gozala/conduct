; <todo-item>: one todo. It shows the checkbox, the title, and the
; delete button, and edits the title in place after a double-click:
; Enter or leaving the field saves the edit, and Escape cancels it. It
; reports each change as a custom event that <todo-app> handles.
;
; The same element as the Zena demo's todo-item.zena, as pure
; definitions: `update` returns the events to send instead of sending
; them.

(define attributes ["todo-id" "title" "completed"])

(define styles "
  :host {
    display: block;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 8px 0 16px;
    border-radius: var(--md-sys-shape-corner-medium);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
  li:hover {
    background: var(--md-sys-color-surface-container);
  }
  .toggle {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--md-sys-color-primary);
  }
  label {
    flex: 1;
    padding: 16px 0;
    word-break: break-word;
  }
  li.completed label {
    color: var(--md-sys-color-outline);
    text-decoration: line-through;
  }
  .destroy {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 22px;
    cursor: pointer;
    opacity: 0;
  }
  li:hover .destroy, .destroy:focus {
    opacity: 1;
  }
  .destroy:hover {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }
  .edit {
    flex: 1;
    margin: 6px 0;
    padding: 12px 16px;
    border: none;
    border-radius: var(--md-sys-shape-corner-small);
    outline: 2px solid var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
")

(type editing : (demo.todo-item/editing boolean))
(type todo-id : (demo.todo-item/id text))
(type title : (demo.todo-item/title text))
(type done : (demo.todo-item/done boolean))

;; The model holds the attributes the element shows, as they change.
(define (init attrs)
  {editing: false
   todo-id: (get :todo-id of: attrs or: "")
   title: (get :title of: attrs or: "")
   done: (= (get :completed of: attrs or: "") "true")})

(define (stay model) {model: model, effects: []})

(define (save title model)
  {model: (assoc model editing: false)
   effects: [(emit "todo-edit" (join [(todo-id model) "\n" title]))]})

;; `update` is defined by clauses on the command it hears: a call takes
;; the narrowest one that matches, so the last, which matches anything,
;; is what any other command does.
(define (update {action: :attribute-changed attribute: :todo-id value: id} model) (stay (assoc model todo-id: id)))
(define (update {action: :attribute-changed attribute: :title value: title} model) (stay (assoc model title: title)))
(define (update {action: :attribute-changed attribute: :completed value: v} model) (stay (assoc model done: (= v "true"))))
(define (update {action: :toggle} model)
  {model: model, effects: [(emit "todo-toggle" (todo-id model))]})
(define (update {action: :destroy} model)
  {model: model, effects: [(emit "todo-destroy" (todo-id model))]})
(define (update {action: :edit} model) (stay (assoc model editing: true)))
(define (update {action: :keydown key: "Escape"} model) (stay (assoc model editing: false)))
(define (update {action: :keydown key: "Enter" params ...} model: {editing: true rest ...})
  (save (value params "") model: rest))
(define (update {action: :save params ...} model: {editing: true rest ...}) (save (value params "") model: rest))
(define (update command model) (stay model))

(define (view model)
  (let [done (done model)
        title (title model)]
    (if (editing model)
      (h "li" {:class "editing"}
        [(h "input" {:key "edit"
                     :class "edit"
                     :value title
                     :autofocus ""
                     :aria-label "Edit the todo"}
            []
            {:keydown :keydown :blur :save})])
      (h "li" {:class (if done "completed" "")}
        [(h "input" {:key "toggle"
                     :class "toggle"
                     :type "checkbox"
                     :checked (if done "true" "false")
                     :aria-label "Toggle the todo"}
            []
            {:change :toggle})
         (h "label" {} [title] {:dblclick :edit})
         (h "button" {:class "destroy" :aria-label "Delete the todo"} ["×"] {:click :destroy})]))))
