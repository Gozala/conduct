; <todo-item>: one todo. It shows the checkbox, the title, and the
; delete button, and edits the title in place after a double-click:
; Enter or leaving the field saves the edit, and Escape cancels it. It
; reports each change as a custom event that <todo-app> handles.
;
; The same element as the Zena demo's todo-item.zena, as pure
; definitions: `update` returns the events to send instead of sending
; them.

(def attributes ["todo-id" "title" "completed"])

(def styles "
  :host {
    display: block;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 8px 0 16px;
    border-radius: var(--md-sys-shape-corner-medium);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
  li:hover {
    background: var(--md-sys-color-surface-container);
  }
  .toggle {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--md-sys-color-primary);
  }
  label {
    flex: 1;
    padding: 16px 0;
    word-break: break-word;
  }
  li.completed label {
    color: var(--md-sys-color-outline);
    text-decoration: line-through;
  }
  .destroy {
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 22px;
    cursor: pointer;
    opacity: 0;
  }
  li:hover .destroy, .destroy:focus {
    opacity: 1;
  }
  .destroy:hover {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }
  .edit {
    flex: 1;
    margin: 6px 0;
    padding: 12px 16px;
    border: none;
    border-radius: var(--md-sys-shape-corner-small);
    outline: 2px solid var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font: var(--md-sys-typescale-body-large);
  }
")

(defn attr [attrs name] (get attrs name ""))

(defn init [attrs] {:editing false})

(defn stay [model] {:model model :effects []})

(defn update [model handler event attrs]
  (let [id (attr attrs "todo-id")]
    (cond
      (= handler "toggle") {:model model :effects [(emit "todo-toggle" id)]}
      (= handler "destroy") {:model model :effects [(emit "todo-destroy" id)]}
      (= handler "edit") (stay {:editing true})
      (and (= handler "key") (= (:key event "") "Escape")) (stay {:editing false})
      (and (:editing model)
           (or (and (= handler "key") (= (:key event "") "Enter")) (= handler "save")))
        {:model {:editing false}
         :effects [(emit "todo-edit" (str id "\n" (:value event "")))]}
      :else (stay model))))

(defn view [model attrs]
  (let [done (= (attr attrs "completed") "true")
        title (attr attrs "title")]
    (if (:editing model)
      (h "li" {"class" "editing"}
        [(h "input" {"key" "edit"
                     "class" "edit"
                     "value" title
                     "autofocus" ""
                     "aria-label" "Edit the todo"}
            []
            {"keydown" "key" "blur" "save"})])
      (h "li" {"class" (if done "completed" "")}
        [(h "input" {"key" "toggle"
                     "class" "toggle"
                     "type" "checkbox"
                     "checked" (if done "true" "false")
                     "aria-label" "Toggle the todo"}
            []
            {"change" "toggle"})
         (h "label" {} [title] {"dblclick" "edit"})
         (h "button" {"class" "destroy" "aria-label" "Delete the todo"} ["×"] {"click" "destroy"})]))))
