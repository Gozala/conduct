;; <todo-input>: the field for a new todo, and the control that marks
;; every todo complete or active. It reports a new title as `todo-add`
;; and the toggle as `todo-toggle-all`, and <todo-app> handles both.
;;
;; The Zena version clears its "clear the field" flag inside `render`.
;; A view here is pure, so the flag is part of the model: an add sets
;; it, and every other update clears it, so it empties the field in the
;; one render after the add. A later render, such as one for a changed
;; attribute, leaves the field to the person typing, even when what
;; they typed came with no keystroke, as a paste from a menu does.

(define attributes ["has-todos" "all-completed"])

(define styles "
      :host {
        display: block;
      }
      .row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px 16px;
      }
      .new-todo {
        flex: 1;
        min-width: 0;
        box-sizing: border-box;
        padding: 16px;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-large);
        background: var(--md-sys-color-surface-container-highest);
        color: var(--md-sys-color-on-surface);
        font: var(--md-sys-typescale-body-large);
      }
      .new-todo:focus {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: -1px;
      }
      .toggle-all {
        width: 24px;
        height: 24px;
        margin: 0;
        accent-color: var(--md-sys-color-primary);
      }
      .label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
    ")

(type clear : (demo.todo-input/clear boolean))
(type has-todos : (demo.todo-input/has-todos boolean))
(type all-completed : (demo.todo-input/all-completed boolean))

(define (init attrs)
  {clear: false
   has-todos: (= (get :has-todos of: attrs or: "") "true")
   all-completed: (= (get :all-completed of: attrs or: "") "true")})

(define (stay model) {model: (assoc model clear: false), effects: []})

(define (add model title: "") (stay model))
(define (add model title) {model: (assoc model clear: true), effects: [(emit "todo-add" title)]})

(define (update {action: :attribute-changed attribute: :has-todos value: v} model)
  (stay (assoc model has-todos: (= v "true"))))
(define (update {action: :attribute-changed attribute: :all-completed value: v} model)
  (stay (assoc model all-completed: (= v "true"))))
(define (update {action: :keydown key: "Enter" value: text} model) (add model title: (trim text)))
(define (update {action: :keydown} model) (stay model))
(define (update {action: :toggle-all params ...} model)
  {model: (assoc model clear: false), effects: [(emit "todo-toggle-all" (if (checked params false) "true" "false"))]})
(define (update command model) (stay model))

;; Both inputs have keys: without them, the checkbox that appears with
;; the first todo would pair with the field, and the field the person is
;; typing in would turn into the checkbox.
(define (field model)
  (let [base {:key "new-todo" :class "new-todo" :placeholder "What needs to be done?" :autofocus ""}]
    (if (clear model) (assoc base :value "") base)))

(define (view model)
  (h "div" {:class "row"}
    [(if (has-todos model)
       (h "input" {:key "toggle-all"
                   :id "toggle-all"
                   :class "toggle-all"
                   :type "checkbox"
                   :checked (if (all-completed model) "true" "false")
                   :aria-label "Mark all as complete"}
          []
          {:change :toggle-all})
       [])
     (h "input" (field model) [] {:keydown :keydown})]))
