;; <todo-input>: the field for a new todo, and the control that marks
;; every todo complete or active. It reports a new title as `todo-add`
;; and the toggle as `todo-toggle-all`, and <todo-app> handles both.
;;
;; The Zena version clears its "clear the field" flag inside `render`.
;; A view here is pure, so the flag is part of the model: an add sets
;; it, and the next keystroke clears it, so a render in between leaves
;; the field empty and one after leaves it to the person typing.

(define attributes ["has-todos" "all-completed"])

(define styles "
      :host {
        display: block;
      }
      .row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px 16px;
      }
      .new-todo {
        flex: 1;
        min-width: 0;
        box-sizing: border-box;
        padding: 16px;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-large);
        background: var(--md-sys-color-surface-container-highest);
        color: var(--md-sys-color-on-surface);
        font: var(--md-sys-typescale-body-large);
      }
      .new-todo:focus {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: -1px;
      }
      .toggle-all {
        width: 24px;
        height: 24px;
        margin: 0;
        accent-color: var(--md-sys-color-primary);
      }
      .label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
      }
    ")

(type clear : (demo.todo-input/clear boolean))

(define (init attrs) {clear: false})

(define (update model handler event attrs)
  (cond
    (and (= handler "key") (= (key event "") "Enter"))
      (let [title (trim (value event ""))]
        (if (= title "")
          {model: model, effects: []}
          {model: (assoc model clear: true), effects: [(emit "todo-add" title)]}))
    (= handler "key") {model: (assoc model clear: false), effects: []}
    (= handler "toggleAll")
      {model: model
       effects: [(emit "todo-toggle-all" (if (checked event false) "true" "false"))]}
    :else {model: model, effects: []}))

(define (field model)
  (let [base {:class "new-todo" :placeholder "What needs to be done?" :autofocus ""}]
    (if (clear model) (assoc base :value "") base)))

(define (view model attrs)
  (h "div" {:class "row"}
    [(if (= (get :has-todos of: attrs or: "") "true")
       (h "input" {:id "toggle-all"
                   :class "toggle-all"
                   :type "checkbox"
                   :checked (get :all-completed of: attrs or: "")
                   :aria-label "Mark all as complete"}
          []
          {:change "toggleAll"})
       [])
     (h "input" (field model) [] {:keydown "key"})]))
