// The element and route worlds with one more export, for tests: how
// many blocks a component's memory holds, so a test through the
// component model can check that memory stays flat.
package conduct:debug;

interface memory {
  live: func() -> u32;
}

world element-component {
  include demo:element/element-component;
  export memory;
}

world route-component {
  include demo:route/route-component;
  export memory;
}
