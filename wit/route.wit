// The route world of the Wasm Component Model Polyfill's TodoMVC demo
// (rust/wcmp-demo/zena/wit/route.wit), with the world's WASI imports
// other than `wasi:http` left out. A route compiled by conduct imports
// only the model functions it calls, and the `wasi:http/types` it
// needs to read a request and answer it.
package demo:route;

world route-component {
  import demo:todo/model;
  import wasi:http/types@0.3.0;
  export wasi:http/handler@0.3.0;
}

package demo:todo {
  // The todo list, which the service worker keeps in IndexedDB.
  interface model {
    record todo {
      id: string,
      title: string,
      completed: bool,
    }

    record counts {
      active: u32,
      completed: u32,
    }

    enum filter {
      all,
      active,
      completed,
    }

    variant model-error {
      not-found,
      empty-title,
    }

    query: async func(filter: filter) -> tuple<list<todo>, counts>;
    add: async func(title: string) -> result<todo, model-error>;
    update: async func(id: string, title: option<string>, completed: option<bool>) -> result<todo, model-error>;
    remove: async func(id: string) -> result<_, model-error>;
    toggle-all: async func(completed: bool);
    clear-completed: async func();
  }
}
