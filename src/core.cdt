;; What every codebase starts with: the types that say how something
;; went. `(ok todo)` and `(error :not-found)` build them and match them.

(claim (ok ?value) : {(conduct.result/ok ?value)})
(claim (error ?reason) : {(conduct.result/error ?reason)})
(claim (result ?value error: ?reason) : [(ok ?value) (error ?reason)])
