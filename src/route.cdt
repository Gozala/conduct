;; What every route starts with, as the demo's `authoring:route` gives
;; its Zena routes: the attributes of requests, responses and the todo
;; model, responses, and the response for a model error.

;; A request, and a response.
(type method : (conduct.http/method text))
(type path : (conduct.http/path text))
(type params : (conduct.http/params (dict text)))
(type search : (conduct.http/query (dict text)))
(type headers : (conduct.http/headers (dict text)))
(type body : (conduct.http/body text))
(type code : (conduct.http/status integer))
(type request : {method path params search headers body})
(type response : {code headers body})

;; A todo, and what the model's `query!` answers.
(type id : (demo.todo/id text))
(type title : (demo.todo/title text))
(type completed : (demo.todo/completed boolean))
(type todos : (demo.todo/todos (list ?todo)))
(type counts : (demo.todo/counts ?counts))
(type active-count : (demo.counts/active integer))
(type completed-count : (demo.counts/completed integer))

;; A response with `value` as its JSON body.
(claim (json ?value status: integer) : response)
(define (json value status)
  {code: status, headers: {:content-type "application/json"}, body: (to-json value)})

;; A response with no body.
(claim (status integer) : response)
(define (status code)
  {code: code, headers: {}, body: ""})

;; The response for a model error: 404 for an unknown todo, 422 for an
;; empty title.
(claim (problem ?error) : response)
(define (problem error)
  (match error
    :not-found (status 404)
    _ (status 422)))
