// The conduct compiler as a component. It imports nothing: a host runs
// it on the Wasm Component Model Polyfill, in a browser or natively, and
// hands it the source to compile.
package conduct:compiler;

interface compiler {
  // A source's failure: its bytes `start` to `end`, and why.
  record problem {
    start: u32,
    end: u32,
    message: string,
  }

  // A definition a source adds: where its name is written, and its type
  // as a claim would write it.
  record shown {
    name: string,
    start: u32,
    end: u32,
    %type: string,
  }

  // The component `source` compiles to in the world `world-name`, which is
  // `element-component` or `route-component`, the worlds of the demo's
  // WIT documents.
  compile: async func(source: string, world-name: string) -> result<list<u8>, problem>;

  // The definitions `source` adds in `world-name`, each with its type.
  check: async func(source: string, world-name: string) -> result<list<shown>, problem>;
}

world conduct-compiler {
  export compiler;
}
